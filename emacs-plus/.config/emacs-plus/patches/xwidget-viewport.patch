 #ifdef NS_IMPL_COCOA
+DEFUN ("xwidget-webkit-set-viewport",
+       Fxwidget_webkit_set_viewport, Sxwidget_webkit_set_viewport,
+       3, 3, 0,
+       doc: /* Set WebKit XWIDGET's WIDTH and HEIGHT in CSS pixels.
+Both dimensions must be integers in 1..4096, or both nil for window sizing.
+The viewport is aspect-fitted into the Emacs window.  */)
+  (Lisp_Object xwidget, Lisp_Object width, Lisp_Object height)
+{
+  WEBKIT_FN_INIT ();
+  int viewport_width = 0;
+  int viewport_height = 0;
+  if (!NILP (width) || !NILP (height))
+    {
+      viewport_width = check_integer_range (width, 1, 4096);
+      viewport_height = check_integer_range (height, 1, 4096);
+    }
+  nsxwidget_webkit_set_viewport (xw, viewport_width, viewport_height);
+  return Qnil;
+}
