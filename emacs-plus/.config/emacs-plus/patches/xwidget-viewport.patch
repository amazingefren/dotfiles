+      NSSize viewport = web_view.viewportSize;
+      CGFloat scale = 1;
+      if (viewport.width == 0)
+        viewport = NSMakeSize (xw->width, xw->height);
+      else
+        scale = MIN (xw->width / viewport.width,
+                     xw->height / viewport.height);
+      [xw->xwWindow setFrameSize:NSMakeSize (viewport.width * scale,
+                                           viewport.height * scale)];
+      [xw->xwWindow setBoundsSize:viewport];
