+/* Sets XW's viewport in CSS pixels; zero dimensions restore window sizing.  */
+void
+nsxwidget_webkit_set_viewport (struct xwidget *xw, int width, int height)
+{
+  XwWebView *web_view = (XwWebView *) xw->xwWidget;
+  web_view.viewportSize = NSMakeSize (width, height);
+  nsxwidget_resize (xw);
+}
