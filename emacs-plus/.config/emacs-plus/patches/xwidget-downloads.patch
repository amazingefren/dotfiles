+/* Completes an explicit download and releases its per-page state.  */
+- (void) finishDownload:(NSString *)failure
+{
+  void (^completion)(id, NSString *) = [[self.downloadCompletion copy] autorelease];
+  NSString *path = [[self.downloadPath copy] autorelease];
+  self.activeDownload.delegate = nil;
+  self.activeDownload = nil;
+  self.downloadPath = nil;
+  self.downloadCompletion = nil;
+  if (completion)
+    completion (@{@"path":path}, failure);
+}
+
+- (void) download:(WKDownload *)download
+  decideDestinationUsingResponse:(NSURLResponse *)response
+  suggestedFilename:(NSString *)suggestedFilename
+  completionHandler:(void (^)(NSURL *))completionHandler
+{
+  if ([[NSFileManager defaultManager] fileExistsAtPath:self.downloadPath])
+    {
+      completionHandler (nil);
+      [self finishDownload:[NSString stringWithFormat:@"Download destination exists: %@", self.downloadPath]];
+      return;
+    }
+  completionHandler ([NSURL fileURLWithPath:self.downloadPath]);
+}
+
+- (void) downloadDidFinish:(WKDownload *)download
+{
+  [self finishDownload:nil];
+}
+
+- (void) download:(WKDownload *)download didFailWithError:(NSError *)error
+  resumeData:(NSData *)resumeData
+{
+  [self finishDownload:[NSString stringWithFormat:@"Download %@ failed: %@",
+    self.downloadPath, error.localizedDescription]];
 }
 
