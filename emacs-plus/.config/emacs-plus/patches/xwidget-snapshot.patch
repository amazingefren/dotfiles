+/* Captures XW's entire viewport into FILE and completes CALLBACK_INDEX.  */
+void
+nsxwidget_webkit_snapshot (struct xwidget *xw, const char *file,
+                          ptrdiff_t callback_index)
+{
+  XwWebView *web_view = (XwWebView *) xw->xwWidget;
+  int width = web_view.bounds.size.width;
+  int height = web_view.bounds.size.height;
+  NSString *path = [NSString stringWithUTF8String:file];
+  WKSnapshotConfiguration *configuration =
+    [[[WKSnapshotConfiguration alloc] init] autorelease];
+  configuration.rect = web_view.bounds;
+  configuration.snapshotWidth = @(width);
+  [web_view takeSnapshotWithConfiguration:configuration
+                       completionHandler:^(NSImage *image, NSError *error) {
+      struct xwidget *widget = web_view.xw;
+      if (!widget || !nsxwidget_is_web_view (widget))
+        return;
+      Lisp_Object callback = AREF (widget->native_callbacks, callback_index);
+      if (NILP (callback))
+        return;
+      NSString *failure = nil;
+      if (error || !image)
+        failure = [NSString stringWithFormat:@"Snapshot %@ failed: %@", path,
+                    error ? error.localizedDescription : @"No image returned"];
+      else
+        {
+          NSBitmapImageRep *bitmap = [[[NSBitmapImageRep alloc]
+            initWithBitmapDataPlanes:NULL pixelsWide:width pixelsHigh:height
+            bitsPerSample:8 samplesPerPixel:4 hasAlpha:YES isPlanar:NO
+            colorSpaceName:NSDeviceRGBColorSpace bytesPerRow:0 bitsPerPixel:0]
+            autorelease];
+          if (!bitmap)
+            failure = [NSString stringWithFormat:@"Cannot allocate snapshot %@", path];
+          else
+            {
+              [NSGraphicsContext saveGraphicsState];
+              [NSGraphicsContext setCurrentContext:
+                [NSGraphicsContext graphicsContextWithBitmapImageRep:bitmap]];
+              [image drawInRect:NSMakeRect (0, 0, width, height)
+                      fromRect:NSZeroRect operation:NSCompositingOperationCopy
+                      fraction:1.0];
+              [NSGraphicsContext restoreGraphicsState];
+              NSData *png = [bitmap representationUsingType:NSBitmapImageFileTypePNG
+                                                properties:@{}];
+              NSError *write_error = nil;
+              if (!png || ![png writeToFile:path options:NSDataWritingAtomic
+                                     error:&write_error])
+                failure = [NSString stringWithFormat:@"Cannot write snapshot %@: %@",
+                            path, write_error ? write_error.localizedDescription
+                                              : @"PNG encoding failed"];
+            }
+        }
+      store_xwidget_js_callback_event
+        (widget, callback, failure ? [failure lispString] : Qnil);
+      ASET (widget->native_callbacks, callback_index, Qnil);
+    }];
+}
