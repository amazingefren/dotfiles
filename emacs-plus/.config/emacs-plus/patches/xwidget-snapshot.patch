+#ifdef NS_IMPL_COCOA
+DEFUN ("xwidget-webkit-snapshot", Fxwidget_webkit_snapshot,
+       Sxwidget_webkit_snapshot, 3, 3, 0,
+       doc: /* Save WebKit XWIDGET's viewport as a PNG at absolute path FILE.
+Call CALLBACK with nil on success or an error string on failure.
+The image has one pixel per viewport point and includes clipped regions.  */)
+  (Lisp_Object xwidget, Lisp_Object file, Lisp_Object callback)
+{
+  WEBKIT_FN_INIT ();
+  CHECK_STRING (file);
+  if (!FUNCTIONP (callback))
+    wrong_type_argument (Qinvalid_function, callback);
+
+  Lisp_Object callbacks = xw->native_callbacks;
+  if (NILP (callbacks))
+    xw->native_callbacks = callbacks = make_nil_vector (4);
+  ptrdiff_t index;
+  for (index = 0; index < ASIZE (callbacks); index++)
+    if (NILP (AREF (callbacks, index)))
+      break;
+  if (index == ASIZE (callbacks))
+    xw->native_callbacks = callbacks = larger_vector (callbacks, 1, -1);
+  ASET (callbacks, index, callback);
+  nsxwidget_webkit_snapshot (xw, SSDATA (ENCODE_UTF_8 (file)), index);
+  return Qnil;
+}
+#endif
