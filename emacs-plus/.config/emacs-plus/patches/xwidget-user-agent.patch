+#ifdef NS_IMPL_COCOA
+DEFUN ("xwidget-webkit-set-user-agent",
+       Fxwidget_webkit_set_user_agent, Sxwidget_webkit_set_user_agent,
+       2, 2, 0,
+       doc: /* Set WebKit XWIDGET's USER_AGENT for subsequent requests.
+USER_AGENT is a string, or nil for WebKit's native default.
+Reload an existing page after changing its user agent.  */)
+  (Lisp_Object xwidget, Lisp_Object user_agent)
+{
+  WEBKIT_FN_INIT ();
+  if (!NILP (user_agent))
+    CHECK_STRING (user_agent);
+  nsxwidget_webkit_set_user_agent
+    (xw, NILP (user_agent) ? NULL : SSDATA (ENCODE_UTF_8 (user_agent)));
+  return Qnil;
+}
+#endif
