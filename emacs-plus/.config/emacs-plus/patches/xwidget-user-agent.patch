+/* Sets XW's user agent; NULL selects WebKit's default.  */
+void
+nsxwidget_webkit_set_user_agent (struct xwidget *xw, const char *user_agent)
+{
+  XwWebView *web_view = (XwWebView *) xw->xwWidget;
+  web_view.customUserAgent = user_agent
+    ? [NSString stringWithUTF8String:user_agent] : nil;
+}
