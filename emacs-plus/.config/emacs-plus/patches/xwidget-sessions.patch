+/* Returns native session results as JSON through a rooted callback.  */
+void
+nsxwidget_webkit_session_command (struct xwidget *xw, const char *request,
+                                 ptrdiff_t callback_index)
+{
+  XwWebView *view = (XwWebView *) xw->xwWidget;
+  NSString *request_string = [NSString stringWithUTF8String:request];
+  NSError *parse_error = nil;
+  NSDictionary *arguments = [NSJSONSerialization JSONObjectWithData:
+    [request_string dataUsingEncoding:NSUTF8StringEncoding] options:0 error:&parse_error];
+  void (^finish)(id, NSString *) = ^(id value, NSString *failure) {
+    struct xwidget *widget = view.xw;
+    if (!widget || !nsxwidget_is_web_view (widget))
+      return;
+    Lisp_Object callback = AREF (widget->native_callbacks, callback_index);
+    if (NILP (callback))
+      return;
+    NSDictionary *reply = failure ? @{@"error": failure} : @{@"value": value};
+    NSError *json_error = nil;
+    NSData *encoded = [NSJSONSerialization dataWithJSONObject:reply options:0 error:&json_error];
+    NSString *json = encoded ? [[[NSString alloc] initWithData:encoded
+      encoding:NSUTF8StringEncoding] autorelease]
+      : @"{\"error\":\"Cannot serialize native session result\"}";
+    store_xwidget_js_callback_event (widget, callback, [json lispString]);
+    ASET (widget->native_callbacks, callback_index, Qnil);
+  };
+  if (parse_error || ![arguments isKindOfClass:NSDictionary.class])
+    {
+      finish (nil, @"Invalid native session request");
+      return;
+    }
+  NSString *operation = arguments[@"operation"];
+  if (![operation isKindOfClass:NSString.class]
+      || (arguments[@"name"] && ![arguments[@"name"] isKindOfClass:NSString.class])
+      || (arguments[@"domain"] && ![arguments[@"domain"] isKindOfClass:NSString.class]))
+    {
+      finish (nil, @"Session operation and cookie filters must be strings");
+      return;
+    }
+  WKWebsiteDataStore *data_store = view.configuration.websiteDataStore;
+  WKHTTPCookieStore *cookies = data_store.httpCookieStore;
+  if ([operation isEqualToString:@"info"])
+    {
+      finish (@{@"profile":view.profileName, @"persistent":@(data_store.persistent),
+        @"editor_focused":@(view.xw->xv && view.window
+          && view.window.firstResponder == view.xw->xv->emacswindow)}, nil);
+      return;
+    }
+  if ([operation isEqualToString:@"clear_data"])
+    {
+      [data_store removeDataOfTypes:[WKWebsiteDataStore allWebsiteDataTypes]
+        modifiedSince:[NSDate distantPast] completionHandler:^{ finish (@{@"cleared":@YES}, nil); }];
+      return;
+    }
+  if ([operation isEqualToString:@"get_cookies"] || [operation isEqualToString:@"clear_cookies"])
+    {
+      [cookies getAllCookies:^(NSArray<NSHTTPCookie *> *stored) {
+        NSMutableArray *selected = [NSMutableArray array];
+        for (NSHTTPCookie *cookie in stored)
+          {
+            if (arguments[@"name"] && ![cookie.name isEqualToString:arguments[@"name"]])
+              continue;
+            if (arguments[@"domain"] && ![cookie.domain isEqualToString:arguments[@"domain"]])
+              continue;
+            [selected addObject:cookie];
+          }
+        if ([operation isEqualToString:@"clear_cookies"])
+          {
+            dispatch_group_t group = dispatch_group_create ();
+            for (NSHTTPCookie *cookie in selected)
+              {
+                dispatch_group_enter (group);
+                [cookies deleteCookie:cookie completionHandler:^{ dispatch_group_leave (group); }];
+              }
+            dispatch_group_notify (group, dispatch_get_main_queue (), ^{
+              finish (@{@"deleted":@(selected.count)}, nil);
+            });
+            dispatch_release (group);
+            return;
+          }
+        NSMutableArray *values = [NSMutableArray array];
+        for (NSHTTPCookie *cookie in selected)
+          [values addObject:@{@"domain":cookie.domain, @"expires":cookie.expiresDate
+            ? @(cookie.expiresDate.timeIntervalSince1970) : @(-1),
+            @"http_only":@(cookie.HTTPOnly), @"name":cookie.name, @"path":cookie.path,
+            @"same_site":cookie.sameSitePolicy.lowercaseString ?: @"", @"secure":@(cookie.secure),
+            @"value":cookie.value}];
+        finish (@{@"cookies":values}, nil);
+      }];
+      return;
+    }
+  if ([operation isEqualToString:@"set_cookies"])
+    {
+      NSMutableArray *prepared = [NSMutableArray array];
+      if (![arguments[@"cookies"] isKindOfClass:NSArray.class])
+        {
+          finish (nil, @"set_cookies needs a cookies array");
+          return;
+        }
+      for (NSDictionary *value in arguments[@"cookies"])
+        {
+          if (![value isKindOfClass:NSDictionary.class]
+              || ![value[@"domain"] isKindOfClass:NSString.class]
+              || ![value[@"name"] isKindOfClass:NSString.class]
+              || ![value[@"path"] isKindOfClass:NSString.class]
+              || ![value[@"value"] isKindOfClass:NSString.class]
+              || (value[@"same_site"] && ![value[@"same_site"] isKindOfClass:NSString.class])
+              || (value[@"expires"] && ![value[@"expires"] isKindOfClass:NSNumber.class])
+              || (value[@"secure"] && ![value[@"secure"] isKindOfClass:NSNumber.class])
+              || (value[@"http_only"] && ![value[@"http_only"] isKindOfClass:NSNumber.class]))
+            {
+              finish (nil, @"Cookie needs string domain, name, path and value");
+              return;
+            }
+          NSMutableDictionary *properties = [NSMutableDictionary dictionaryWithDictionary:
+            @{NSHTTPCookieDomain:value[@"domain"], NSHTTPCookieName:value[@"name"],
+              NSHTTPCookiePath:value[@"path"], NSHTTPCookieValue:value[@"value"]}];
+          if ([value[@"secure"] boolValue]) properties[NSHTTPCookieSecure] = @"TRUE";
+          if ([value[@"http_only"] boolValue]) properties[@"HttpOnly"] = @"TRUE";
+          if (value[@"same_site"] && [value[@"same_site"] length])
+            properties[NSHTTPCookieSameSitePolicy] = value[@"same_site"];
+          if (value[@"expires"] && [value[@"expires"] doubleValue] >= 0)
+            properties[NSHTTPCookieExpires] = [NSDate dateWithTimeIntervalSince1970:
+              [value[@"expires"] doubleValue]];
+          NSHTTPCookie *cookie = [NSHTTPCookie cookieWithProperties:properties];
+          if (!cookie)
+            {
+              finish (nil, [NSString stringWithFormat:@"Invalid cookie %@ for %@",
+                value[@"name"], value[@"domain"]]);
+              return;
+            }
+          [prepared addObject:cookie];
+        }
+      dispatch_group_t group = dispatch_group_create ();
+      for (NSHTTPCookie *cookie in prepared)
+        {
+          dispatch_group_enter (group);
+          [cookies setCookie:cookie completionHandler:^{ dispatch_group_leave (group); }];
+        }
+      dispatch_group_notify (group, dispatch_get_main_queue (), ^{
+        finish (@{@"set":@(prepared.count)}, nil);
+      });
+      dispatch_release (group);
+      return;
+    }
+  finish (nil, [NSString stringWithFormat:@"Unknown native session operation %@", operation]);
+}
