 #ifdef NS_IMPL_COCOA
+DEFUN ("xwidget-webkit-session-command", Fxwidget_webkit_session_command,
+       Sxwidget_webkit_session_command, 3, 3, 0,
+       doc: /* Run JSON REQUEST against WebKit XWIDGET's native data store.
+Call CALLBACK with a JSON string containing value or error.
+Supports info, get_cookies, set_cookies, clear_cookies and clear_data.  */)
+  (Lisp_Object xwidget, Lisp_Object request, Lisp_Object callback)
+{
+  WEBKIT_FN_INIT ();
+  CHECK_STRING (request);
+  if (!FUNCTIONP (callback))
+    wrong_type_argument (Qinvalid_function, callback);
+  ptrdiff_t callback_index = save_native_callback (xw, callback);
+  nsxwidget_webkit_session_command (xw, SSDATA (ENCODE_UTF_8 (request)), callback_index);
+  return Qnil;
+}
+#endif
