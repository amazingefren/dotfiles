#!/usr/bin/env python3
"""Expose a running Emacs instance to local MCP clients over stdio."""

import base64
import json
import os
import subprocess
import sys

sys.dont_write_bytecode = True
from codex_subagents import metadata as codex_session_metadata


TOOLS = [
    {
        "name": "emacs_context",
        "description": "Inspect Emacs's live workspace, active buffer, cursor, and visible windows.",
        "inputSchema": {"type": "object", "properties": {}},
    },
    {
        "name": "emacs_open_file",
        "description": "Load a workspace file into an Emacs buffer without changing editor windows, so Emacs diagnostics and navigation can inspect it.",
        "inputSchema": {"type": "object", "properties": {"path": {"type": "string"}, "line": {"type": "integer", "minimum": 1}}, "required": ["path"]},
    },
    {
        "name": "emacs_edit_file",
        "description": "Apply exact text replacements through a live Emacs buffer and save. Each old_text must occur exactly once; dirty or stale buffers are rejected.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "path": {"type": "string"},
                "edits": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "properties": {"old_text": {"type": "string", "minLength": 1}, "new_text": {"type": "string"}},
                        "required": ["old_text", "new_text"],
                    },
                },
            },
            "required": ["path", "edits"],
        },
    },
    {
        "name": "emacs_create_file",
        "description": "Create and save a new file through an Emacs buffer. Its parent directory must already exist.",
        "inputSchema": {"type": "object", "properties": {"path": {"type": "string"}, "content": {"type": "string"}}, "required": ["path", "content"]},
    },
    {
        "name": "emacs_diagnostics",
        "description": "Read the current Flymake/Eglot diagnostics for a file already known to Emacs. Relative paths use the active Emacs workspace.",
        "inputSchema": {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]},
    },
    {
        "name": "emacs_symbols",
        "description": "Read Emacs's Imenu symbol index for a file, including line and column positions.",
        "inputSchema": {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]},
    },
    {
        "name": "emacs_selection_context",
        "description": "Read the selection, symbol, and cursor context at a file location in this agent's launch workspace.",
        "inputSchema": {"type": "object", "properties": {"path": {"type": "string"}, "line": {"type": "integer", "minimum": 1}, "column": {"type": "integer", "minimum": 0}, "max_characters": {"type": "integer", "minimum": 1}}, "required": ["path"]},
    },
    {
        "name": "emacs_xref_definitions",
        "description": "Find Emacs/xref definitions for the identifier at a file location, scoped to this workspace.",
        "inputSchema": {"type": "object", "properties": {"path": {"type": "string"}, "line": {"type": "integer", "minimum": 1}, "column": {"type": "integer", "minimum": 0}, "max_results": {"type": "integer", "minimum": 1}}, "required": ["path", "line"]},
    },
    {
        "name": "emacs_xref_references",
        "description": "Find Emacs/xref references for the identifier at a file location, scoped to this workspace.",
        "inputSchema": {"type": "object", "properties": {"path": {"type": "string"}, "line": {"type": "integer", "minimum": 1}, "column": {"type": "integer", "minimum": 0}, "max_results": {"type": "integer", "minimum": 1}}, "required": ["path", "line"]},
    },
    {
        "name": "emacs_documentation_at_point",
        "description": "Read immediate Emacs or ElDoc documentation for the symbol at a file location.",
        "inputSchema": {"type": "object", "properties": {"path": {"type": "string"}, "line": {"type": "integer", "minimum": 1}, "column": {"type": "integer", "minimum": 0}}, "required": ["path", "line"]},
    },
]

TOOL_NAMES = frozenset(tool["name"] for tool in TOOLS)


def emacs_call(method, arguments):
    arguments = dict(arguments)
    arguments.update(bridge_context())
    payload = base64.b64encode(json.dumps(arguments).encode()).decode()
    expression = '(emacs-mcp-dispatch "%s" "%s")' % (method, payload)
    command = [os.environ.get("EMACSCLIENT", "emacsclient"), "-s", os.environ.get("EMACS_SERVER_NAME", "server"), "--eval", expression]
    completed = subprocess.run(command, capture_output=True, text=True)
    if completed.returncode:
        raise RuntimeError(completed.stderr.strip() or completed.stdout.strip() or "emacsclient failed")
    result = json.loads(completed.stdout.strip())
    return json.loads(result) if isinstance(result, str) else result


def agent_identity():
    return os.environ.get("EMACS_MCP_AGENT_NAME", "Codex")


def bridge_context():
    root = os.environ.get("EMACS_MCP_WORKSPACE_ROOT")
    if not root or not os.path.isdir(root):
        raise RuntimeError("Emacs MCP requires a Herdr-launched agent workspace")
    return {
        "__emacs_mcp_workspace_root": root,
        "__emacs_mcp_agent_name": agent_identity(),
        "__emacs_mcp_herdr_session": os.environ.get("EMACS_MCP_HERDR_SESSION", ""),
        "__emacs_mcp_pane": os.environ.get("HERDR_PANE_ID", ""),
    }


def register_codex_thread():
    """Tell Emacs which root Codex thread occupies this Herdr pane."""
    thread = os.environ.get("CODEX_THREAD_ID")
    pane = os.environ.get("HERDR_PANE_ID")
    session = os.environ.get("EMACS_MCP_HERDR_SESSION")
    if not all((thread, pane, session)):
        return
    info = codex_session_metadata(thread)
    if not info or info.get("parent_thread_id"):
        return
    expression = "(herdr-register-codex-thread %s %s %s)" % tuple(
        json.dumps(value) for value in (session, pane, thread)
    )
    command = [os.environ.get("EMACSCLIENT", "emacsclient"), "-s",
               os.environ.get("EMACS_SERVER_NAME", "server"), "--eval", expression]
    try:
        # Herdr may still be waiting for this MCP initialize response while
        # Emacs is inside `herdr-start'.  Let Emacs process the report later.
        subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def response(request_id, result=None, error=None):
    message = {"jsonrpc": "2.0", "id": request_id}
    if error:
        message["error"] = error
    else:
        message["result"] = result
    sys.stdout.write(json.dumps(message, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def handle(message):
    method = message.get("method")
    request_id = message.get("id")
    if method == "notifications/initialized":
        return
    if method == "initialize":
        register_codex_thread()
        response(request_id, {"protocolVersion": "2025-06-18", "capabilities": {"tools": {}}, "serverInfo": {"name": "emacs", "version": "0.3"}, "instructions": "Use these tools when live Emacs state is useful: visible buffers, selection, diagnostics, symbols, xref, and documentation. Emacs edit and create tools save through live buffers and reject dirty or stale conflicts. The user's live diff follower observes file changes independently of MCP tool use."})
    elif method == "tools/list":
        response(request_id, {"tools": TOOLS})
    elif method == "tools/call":
        tool = message.get("params", {}).get("name", "")
        if tool not in TOOL_NAMES:
            response(request_id, error={"code": -32602, "message": "Unknown tool"})
            return
        try:
            result = emacs_call(tool.removeprefix("emacs_"), message.get("params", {}).get("arguments", {}))
            if "error" in result:
                raise RuntimeError(result["error"])
            response(request_id, {"content": [{"type": "text", "text": json.dumps(result, indent=2)}]})
        except Exception as exc:
            response(request_id, {"content": [{"type": "text", "text": str(exc)}], "isError": True})
    else:
        response(request_id, error={"code": -32601, "message": "Method not found"})


for line in sys.stdin:
    try:
        handle(json.loads(line))
    except Exception as exc:
        print("emacs-mcp: %s" % exc, file=sys.stderr)
